prototype(Neos.Neos:Document.BackendInformation) < prototype(Neos.Fusion:Component) {
  content = null

  renderer = Neos.Neos:Page {
    head {
      backend-information-css = Neos.Fusion:Tag {
        tagName = 'style'
        content = Neos.Fusion:Value {
          value = '#neos-backend-information {position: fixed;top: 0;left: 0;width: 100%;height: 100%;background-color: #323232;z-index: 9999;font-family: "Noto Sans", sans-serif;-webkit-font-smoothing: antialiased;}#neos-backend-information p {position: relative;margin: 0 auto;width: 500px;height: 60px;top: 50%;margin-top: -30px;color: #fff;font-size: 22px;line-height: 1.4;text-align: center;}#neos-backend-information p a {color: #00b5ff;text-decoration: none;}#neos-backend-information p a:hover {color: #39c6ff;}'
        }
      }
    }

    body = afx`
      <div id="neos-backend-information">{props.content}</div>
    `
  }
}
